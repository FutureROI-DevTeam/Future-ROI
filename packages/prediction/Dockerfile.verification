# CI用の検証Node版。製品runtimeや配備用imageの採択ではない（製品runtimeはroot Dockerfile参照）。
# build contextはrepositoryのroot。workspaceのlockfileからprediction packageの検証依存だけを取得する。
FROM docker.io/library/node:22.23.4-bookworm-slim@sha256:5991875dfb80938dd8a6ba3fe3e96fd04929e70792762b3319d8caadbbe229bc

WORKDIR /work
RUN chown node:node /work
USER node
COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node apps/api/package.json apps/api/
COPY --chown=node:node apps/web/package.json apps/web/
COPY --chown=node:node packages/prediction/package.json packages/prediction/
# lockの検証依存だけを取得し、lifecycle scriptsは実行しない。
RUN npm ci --workspace=@futureroi/prediction --include=dev --ignore-scripts --no-audit --no-fund
COPY --chown=node:node packages/prediction/tsconfig.json packages/prediction/
COPY --chown=node:node packages/prediction/src/ packages/prediction/src/
COPY --chown=node:node packages/prediction/tests/ packages/prediction/tests/
COPY --chown=node:node packages/prediction/scripts/ packages/prediction/scripts/
COPY --chown=node:node packages/prediction/examples/ packages/prediction/examples/

WORKDIR /work/packages/prediction
CMD ["node", "scripts/verify-docker.mjs"]
